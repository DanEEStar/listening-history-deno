{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:legacy": "nuxt build && gsed -i '1i import { Buffer } from '\\''node:buffer'\\'';' .output/server/chunks/nitro/nitro.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "npm run build && (cd .output && deployctl deploy --project=listening-history-deno server/index.mjs)",
    "gen-types": "supabase gen types --project-id=kwbeldipfntekywbzrqv > database.generated.types.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@nuxt/icon": "^1.0.0",
    "@nuxtjs/supabase": "^1.4.2",
    "jose": "^6.1.0",
    "nuxt": "^4.4.0",
    "postgres": "^3.4.5",
    "type-fest": "^4.26.1",
    "vue": "^3.5.12",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "@vueuse/core": "^13.3.0",
    "@vueuse/nuxt": "^13.3.0",
    "oxfmt": "^0.44.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0"
  }
}
