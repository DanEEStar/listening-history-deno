{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:legacy": "nuxt build && gsed -i '1i import { Buffer } from '\\''node:buffer'\\'';' .output/server/chunks/nitro/nitro.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "npm run build && (cd .output && deployctl deploy --project=listening-history-deno server/index.mjs)",
    "gen-types": "supabase gen types --project-id=kwbeldipfntekywbzrqv > database.generated.types.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@nuxt/icon": "^2.4.1",
    "@nuxtjs/supabase": "^2.0.9",
    "jose": "^6.2.4",
    "nuxt": "^4.5.1",
    "postgres": "^3.4.9",
    "type-fest": "^5.8.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "oxfmt": "^0.61.0",
    "tailwindcss": "^4.3.3"
  }
}
